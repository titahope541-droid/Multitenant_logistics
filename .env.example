# ─────────────────────────────────────────────────────────────────────────────
# MERIDIAN — Multi-Tenant Logistics Platform · Phase 1
# Copy this file to `.env` and set values locally.
# NEVER commit `.env` — it is git-ignored on purpose.
# Placeholders only below. Real credentials live in your password manager /
# deployment secret store, never in Git, docs, or client code.
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER ONLY (secret — never exposed to the browser) ──────────────────────

# MongoDB connection string (Mongoose ODM).
# Local default:    mongodb://127.0.0.1:27017/meridian
# MongoDB Atlas:    mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/meridian
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# Secret used to sign session cookies (Phase 3 — Authentication).
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace_with_secure_random_value

# Structured log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── PUBLIC (embedded into the browser bundle — never put secrets here) ───────
# Anything prefixed NEXT_PUBLIC_ is shipped to the client. Public URLs only.

# Absolute origin of the application (used for absolute links, SEO, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base path of the API tier the browser talks to.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Placeholder platform domain. Tenants will eventually resolve as
# {tenant}.yourplatform.com  (subdomains only in V1 — locked decision).
NEXT_PUBLIC_PLATFORM_DOMAIN=nttrack.com

# Additional trusted host suffixes that serve the PLATFORM surface only
# (comma-separated; tenants never resolve through them). Use for preview/
# staging platforms whose own hostname is not your platform domain.
# PLATFORM_HOST_SUFFIXES=.preview.example.com
PLATFORM_HOST_SUFFIXES=

# ── GEOCODING (server-only, backend-mediated — Phase 7) ─────────────────
# Provider is swappable via these values; nothing reaches the browser.
# Default points at the public OSM Nominatim host. PRODUCTION: use a
# self-hosted or commercially licensed instance (docs/maps.md §licensing).
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=meridian-logistics/0.1 (multi-tenant tracking platform)
# GEOCODING_CONTACT=ops-contact@example.com

# ── PUBLIC (tiles are URLs served to browsers — public by nature) ───────
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── PRODUCTION runtime ──────────────────────────────────────────────────
# NODE_ENV=production is set by the PM2 ecosystem file (ecosystem.config.cjs).
# PORT defaults to 3000 behind Nginx — do not expose the port publicly.
# COOKIE DOMAIN: intentionally NOT configurable — cookies are host-only
# (the narrowest secure scope). Admin console session lives on
# admin.{domain}, tenant admin session on {slug}.{domain}; there is never
# a shared .{domain} cookie by design (docs/deployment.md §cookies).
NODE_ENV=production
PORT=3000
